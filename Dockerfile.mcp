FROM node:22-alpine

WORKDIR /app

# Install dependencies (cached by Docker if package.json does not change)
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

ENV NODE_ENV=production
ENV MCP_PORT=3001
ENV DATABASE_URL="postgresql://pure_user:pure_secure_password_2026@pure-db:5432/pure_academic?sslmode=disable"

EXPOSE 3001

CMD ["npx", "tsx", "mcp-server/index.ts"]
