# =============================================================================
# PURE OS — Environment Variables Template (.env.example)
# =============================================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Application Web Port
PORT=3000

# PostgreSQL Database Configuration
POSTGRES_USER=pure_user
POSTGRES_PASSWORD=pure_secure_password_2026
POSTGRES_DB=pure_academic
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostgreSQL Full Connection String
# For local dev outside Docker: postgresql://pure_user:pure_secure_password_2026@localhost:5432/pure_academic?sslmode=disable
# For Docker Compose inside network: postgresql://pure_user:pure_secure_password_2026@pure-db:5432/pure_academic?sslmode=disable
DATABASE_URL=postgresql://pure_user:pure_secure_password_2026@localhost:5432/pure_academic?sslmode=disable

# Model Context Protocol (MCP) Server Settings
MCP_PORT=3001

# Optional Supabase Cloud / External Integration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo_key
