# =============================================================================
# PURE OS — Environment Variables Template (.env.example)
# =============================================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Application Web Port
PORT=3000

# PostgreSQL Database Configuration
POSTGRES_USER=pure_user
POSTGRES_PASSWORD=pure_secure_password_2026
POSTGRES_DB=pure_academic
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostgreSQL Full Connection String
# For local dev outside Docker: postgresql://pure_user:pure_secure_password_2026@localhost:5432/pure_academic?sslmode=disable
# For Docker Compose inside network: postgresql://pure_user:pure_secure_password_2026@pure-db:5432/pure_academic?sslmode=disable
DATABASE_URL=postgresql://pure_user:pure_secure_password_2026@localhost:5432/pure_academic?sslmode=disable

# Model Context Protocol (MCP) Server Settings
MCP_PORT=3001

# Optional Supabase Cloud / External Integration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo_key

# =============================================================================
# Módulo de Ejecución
# =============================================================================

# Zona horaria usada por lib/execution/time.ts para todo cálculo de día/hora (US1-US9)
PURE_TZ=America/Bogota

# Activa el tick programado (cierre de tandas, congelamiento y envío del reporte, avisos push)
# dentro del proceso del servidor MCP. "off" en pure-web, "on" en pure-mcp.
EXECUTION_SCHEDULER=off

# Nombre del dueño del reporte semanal, usado en el texto del correo (US6)
REPORT_OWNER_NAME=Andres

# URL pública de la web, usada en los avisos push (url de la notificación) y al instalar la PWA
PUBLIC_WEB_URL=

# ZeptoMail: envío del reporte semanal por correo vía su API HTTP (sin nodemailer ni SMTP)
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=https://api.zeptomail.com/v1.1/email
REPORT_FROM=
REPORT_FROM_NAME=
REPORT_REPLY_TO=

# Web Push (VAPID): avisos de fin de tanda, reporte congelado y fallo de envío (US7)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
