# Pure OS — Environment Configuration

# PostgreSQL Database
POSTGRES_USER=pure_user
POSTGRES_PASSWORD=pure_secure_password_2026
POSTGRES_DB=pure_academic

# MCP HTTP Server
# Generate a strong token: openssl rand -hex 32
MCP_HTTP_PORT=3001
MCP_AUTH_TOKEN=your_strong_bearer_token_here_64_chars_min

# Supabase (Optional)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo_key
